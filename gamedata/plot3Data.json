[{"kindId":1,"page":2,"no":1,"classId":36,"side":1,"text":"走这条捷径是最快到达村里的了。"},{"kindId":2,"page":2,"no":2,"classId":32,"side":2,"text":"如果能随时通灵出文太，赶路就方便多了！"},{"kindId":3,"page":2,"no":3,"classId":36,"side":1,"text":"嘘……周围有敌人"},{"kindId":4,"page":3,"no":1,"classId":3,"side":1,"text":"你们怎么出现在这!快躲起来！"},{"kindId":5,"page":3,"no":2,"classId":32,"side":2,"text":"老师，我也要和大家一起战斗！"},{"kindId":6,"page":3,"no":3,"classId":3,"side":1,"text":"比起这里的危险，我有更重要的事情需要你们的帮助。"},{"kindId":7,"page":3,"no":4,"classId":3,"side":1,"text":"一些忍者学院的物资被敌人夺走了，你们去村外西北方向小心跟踪，等我追上来。"},{"kindId":8,"page":3,"no":5,"classId":32,"side":2,"text":"老师……"},{"kindId":9,"page":3,"no":6,"classId":3,"side":1,"text":"放心吧，村内的战斗很快就结束了。如果你们现在赶过去，应该还来的及在敌人逃走前发现物资的踪迹，拜托了！"},{"kindId":10,"page":3,"no":7,"classId":32,"side":2,"text":"老师一定要小心呀！"},{"kindId":11,"page":5,"no":1,"classId":63,"side":1,"text":"快趴下！"},{"kindId":12,"page":5,"no":2,"classId":32,"side":2,"text":"哼哼！来了！来了！我这回不能再……我不会输给佐助的！"},{"kindId":13,"page":5,"no":3,"classId":63,"side":1,"text":"别乱来！都退后！你们去设法把雾清除。再不斩，你的对手……是我！"},{"kindId":14,"page":6,"no":1,"classId":32,"side":2,"text":"秘宝？！！可以吃很多碗拉面吧？！！我们快去找到人帮忙吧，这样卡卡西老师胜算会变大！"},{"kindId":15,"page":7,"no":1,"classId":36,"side":1,"text":"伊那里说的方法果然是对的，雾气消失了。"},{"kindId":16,"page":7,"no":2,"classId":54,"side":2,"text":"不对，浓雾没有全部消失，还有什么关键之处没有发现。"},{"kindId":17,"page":8,"no":1,"classId":63,"side":1,"text":"雾气消散了，这回的确是真身。"},{"kindId":18,"page":8,"no":2,"classId":13,"side":2,"text":"真是太谢谢你了！我一直都在……寻找能够杀掉再不斩的机会。"},{"kindId":19,"page":8,"no":3,"classId":32,"side":2,"text":"你在胡说什么啊！你究竟是什么人？"},{"kindId":20,"page":8,"no":4,"classId":63,"side":1,"text":"别担心，鸣人！他并非敌人！"},{"kindId":21,"page":8,"no":5,"classId":13,"side":1,"text":"你们的战斗就到此为止了吧？但我还需要对尸体进行处理！因为它藏有太多的秘密……"},{"kindId":22,"page":8,"no":6,"classId":13,"side":1,"text":"那我就先走一步了。"},{"kindId":23,"page":8,"no":7,"classId":63,"side":1,"text":"走啦！我们还得快点送达兹纳先生回家呢！"},{"kindId":24,"page":9,"no":1,"classId":32,"side":2,"text":"波之国真的有秘宝吗？"},{"kindId":25,"page":9,"no":2,"classId":63,"side":1,"text":"这个不确定，但我在东北方向感到了异常的波动，可以去看看发生了什么。"},{"kindId":26,"page":25,"no":1,"classId":73,"side":1,"text":"看到他们俩个逃跑的方向了吗？实在不行只能去问那个可怕的女人了……"},{"kindId":27,"page":25,"no":2,"classId":36,"side":2,"text":"手鞠吗？不是挺温柔的嘛。右边好像有动静，追！"},{"kindId":28,"page":25,"no":3,"classId":73,"side":1,"text":"应该离这不远，先找找看吧。"},{"kindId":29,"page":26,"no":1,"classId":73,"side":1,"text":"终于追上了，这下可以去挑战手鞠了"},{"kindId":30,"page":26,"no":2,"classId":36,"side":2,"text":"那快走吧，我记得手鞠在西边位置上。"},{"kindId":31,"page":26,"no":3,"classId":73,"side":1,"text":"好"},{"kindId":32,"page":27,"no":1,"classId":59,"side":1,"text":"想要追击君麻吕？你究竟会不会白白送命，就让我来检验一下吧。"},{"kindId":33,"page":27,"no":2,"classId":59,"side":1,"text":"只要击败我和两位敌人首领，你便能知道君麻吕的位置。"},{"kindId":34,"page":28,"no":1,"classId":59,"side":1,"text":"很遗憾，你们没有击败那两位首领，君麻吕的位置我不能告诉你。"},{"kindId":35,"page":29,"no":1,"classId":59,"side":1,"text":"木叶的盟友们，君麻吕在西北方向，小心行事，注意安全。"},{"kindId":36,"page":30,"no":1,"classId":78,"side":2,"text":"为了实现大蛇丸大人的野心，我一直都在努力。"},{"kindId":37,"page":30,"no":2,"classId":78,"side":2,"text":"所以我会永远，留在大蛇丸大人的心里。"},{"kindId":38,"page":34,"no":1,"classId":32,"side":2,"text":"小樱，你还是个爱哭鬼啊。别担心……"},{"kindId":39,"page":34,"no":2,"classId":36,"side":1,"text":"鸣人！我这是……"},{"kindId":40,"page":34,"no":3,"classId":32,"side":2,"text":"快点赶路吧！"},{"kindId":41,"page":35,"no":1,"classId":50,"side":1,"text":"就是这儿！"},{"kindId":42,"page":35,"no":2,"classId":53,"side":2,"text":"那……那是什么？"},{"kindId":43,"page":35,"no":3,"classId":11,"side":1,"text":"什么情况，宁次？"},{"kindId":44,"page":35,"no":4,"classId":45,"side":1,"text":"宁次……岩石后面究竟是什么啊？"},{"kindId":45,"page":35,"no":5,"classId":53,"side":2,"text":"真是难以形容……"},{"kindId":46,"page":36,"no":1,"classId":63,"side":1,"text":"来晚了吗……"},{"kindId":47,"page":36,"no":2,"classId":35,"side":2,"text":"蝎……"},{"kindId":48,"page":36,"no":3,"classId":40,"side":1,"text":"说起来……人柱力究竟是哪一个呢……嗯？"},{"kindId":49,"page":36,"no":4,"classId":32,"side":2,"text":"你们这帮混蛋！我要宰了你们！"},{"kindId":50,"page":36,"no":5,"classId":72,"side":1,"text":"看来是他……"},{"kindId":51,"page":36,"no":6,"classId":40,"side":1,"text":"错不了了……嗯。"},{"kindId":52,"page":51,"no":1,"classId":18,"side":2,"text":"潜入的顺序是……我、小樱、鸣人。"},{"kindId":53,"page":51,"no":2,"classId":36,"side":1,"text":"潜入的方式呢？"},{"kindId":54,"page":51,"no":3,"classId":18,"side":2,"text":"按惯例，用土遁从地下靠近。"},{"kindId":55,"page":51,"no":4,"classId":32,"side":2,"text":"我终于……找到你了……"},{"kindId":56,"page":52,"no":1,"classId":18,"side":2,"text":"我好像听到了什么声音？"},{"kindId":57,"page":52,"no":2,"classId":36,"side":1,"text":"看，南边这块岩石碎开了，但咒印的力量并没有消失。"},{"kindId":58,"page":53,"no":1,"classId":32,"side":2,"text":"要是你们打算妨碍我们，就别怪我待会无情。"},{"kindId":59,"page":54,"no":1,"classId":32,"side":2,"text":"你怎么还没搞清楚状况啊！过不了多久，大蛇丸就会夺取你的身体了啊！"},{"kindId":60,"page":54,"no":2,"classId":54,"side":1,"text":"那又如何？鸣人，你还是这么幼稚……"},{"kindId":61,"page":54,"no":3,"classId":54,"side":1,"text":"对我而言，报仇就是全部。只要能报仇，无论我自己变成什么样子。"},{"kindId":62,"page":54,"no":4,"classId":54,"side":1,"text":"或者这个世界变成什么样子，都与我无关。"},{"kindId":63,"page":67,"no":1,"classId":18,"side":2,"text":"已经准备好了，我们走吧。"},{"kindId":64,"page":67,"no":2,"classId":32,"side":2,"text":"混蛋盗墓小贼，我来揍飞你们！"},{"kindId":65,"page":68,"no":1,"classId":32,"side":2,"text":"这些家伙什么情况？"},{"kindId":66,"page":68,"no":2,"classId":36,"side":1,"text":"鸣人！小心背后！"},{"kindId":67,"page":69,"no":1,"classId":18,"side":2,"text":"我们还是先把周围的敌人全部击退再调查吧。"},{"kindId":68,"page":70,"no":1,"classId":32,"side":2,"text":"真的假的，真有这种地方啊，传说中的密道。"},{"kindId":69,"page":70,"no":2,"classId":52,"side":1,"text":"被夺走的尸体会被用做什么？"},{"kindId":70,"page":70,"no":3,"classId":18,"side":2,"text":"也许是想要尸体上的情报，或者是像大蛇丸那样，直接利用遗体本身。"},{"kindId":71,"page":71,"no":1,"classId":18,"side":2,"text":"竟然用土遁引起这样的地质变化，只要我们破坏了有为转变之术，战局一定会变得对我们有利。"},{"kindId":72,"page":72,"no":1,"classId":18,"side":2,"text":"新的敌人又填补了刚刚打开的缺口，这里似乎很难突破，或许我们应该先去调查西北方向的南午之墓。"},{"kindId":73,"page":73,"no":1,"classId":32,"side":2,"text":"投降吧，你已经输了，为什么要破坏墓地！"},{"kindId":74,"page":74,"no":1,"classId":36,"side":1,"text":"不好，我们被伏兵包围了。"},{"kindId":75,"page":74,"no":2,"classId":52,"side":1,"text":"中计了，不过这么多伏兵，其他地方的突破难度或许就会变小。"},{"kindId":76,"page":82,"no":1,"classId":28,"side":2,"text":"那双写轮眼，你能看到多远呢。"},{"kindId":77,"page":82,"no":2,"classId":54,"side":1,"text":"你问我能看到多远？现在我的眼中所能看到的，鼬，是你被我杀死的样子。"},{"kindId":78,"page":82,"no":3,"classId":28,"side":2,"text":"我被杀死的样子吗。那么……"},{"kindId":79,"page":82,"no":4,"classId":28,"side":2,"text":"将它再现出来给我看看吧。"},{"kindId":80,"page":83,"no":1,"classId":54,"side":1,"text":"这不断崩塌的空间，就是你最擅长的幻术闹剧了吗？"},{"kindId":81,"page":83,"no":2,"classId":28,"side":2,"text":"人们都会依赖自己的知识和认知，并一直被这些东西所束缚……"},{"kindId":82,"page":85,"no":1,"classId":102,"side":1,"text":"糟糕，被伏击了。有大量敌人在这里设伏阻碍我们，必须尽快突围了！"},{"kindId":83,"page":86,"no":1,"classId":54,"side":1,"text":"你就是八尾的人柱力吗？"},{"kindId":84,"page":86,"no":2,"classId":61,"side":2,"text":"不，应该说“您是八尾大人吗”才对，这里。"},{"kindId":85,"page":86,"no":3,"classId":61,"side":2,"text":"该说“您是人柱力吗？”才对，这里。"},{"kindId":86,"page":86,"no":4,"classId":54,"side":1,"text":"我们要抓捕你。"},{"kindId":87,"page":86,"no":5,"classId":61,"side":2,"text":"所以说，该说“容我们抓捕您”才对吧，这里。"},{"kindId":88,"page":87,"no":1,"classId":41,"side":1,"text":"桥面升起了一部分，我们要尽快赶去帮助佐助！"},{"kindId":89,"page":87,"no":2,"classId":64,"side":2,"text":"这桥面很诡异，似乎有对应的机关隐藏在各处。"},{"kindId":90,"page":87,"no":3,"classId":41,"side":1,"text":"怎么会有这么多落石，好痛（队伍忍者扣血），这里也被八尾的力量影响到了吗？得快点去支援佐助了。"},{"kindId":91,"page":88,"no":1,"classId":63,"side":1,"text":"好了，我爱罗。你是这次忍者联军的队长，放轻松给大家说两句吧。"},{"kindId":92,"page":88,"no":2,"classId":55,"side":2,"text":"为了各自国家各自村子的利益，在第一次至第三次的漫长战争中，忍者们互相伤害，互相憎恨。"},{"kindId":93,"page":88,"no":3,"classId":55,"side":2,"text":"那份憎恨孕育了对力量的渴求，才有了我的诞生。"},{"kindId":94,"page":88,"no":4,"classId":55,"side":2,"text":"曾经的我是一个人柱力，是憎恨和力量的化身。并且，我憎恨这个世界和人类，希望亲手毁灭一切。"},{"kindId":95,"page":88,"no":5,"classId":55,"side":2,"text":"和“晓”现在打算做的事情完全一样。"},{"kindId":96,"page":88,"no":6,"classId":55,"side":2,"text":"然而！木叶的一名忍者阻止了我！即便我曾是他的敌人，它也会为我而哭泣。"},{"kindId":97,"page":88,"no":7,"classId":55,"side":2,"text":"将伤害过自己的我，视作朋友。是他拯救了我！"},{"kindId":98,"page":88,"no":8,"classId":55,"side":2,"text":"这样一个同为人柱力的敌人，身怀同样痛苦，彼此理解的两者之间，不存在芥蒂。"},{"kindId":99,"page":88,"no":9,"classId":55,"side":2,"text":"此时此地不存在敌人！因为大家都背负着“晓”留下的伤痛！"},{"kindId":100,"page":88,"no":10,"classId":55,"side":2,"text":"因此这里没有砂隐，没有岩隐，没有木叶，没有雾隐，也没有云隐！"},{"kindId":101,"page":88,"no":11,"classId":55,"side":2,"text":"有的只是……"},{"kindId":102,"page":88,"no":12,"classId":55,"side":2,"text":"忍者！"},{"kindId":103,"page":90,"no":1,"classId":36,"side":1,"text":"外面现在怎么样了？……佐助"},{"kindId":104,"page":90,"no":2,"classId":54,"side":2,"text":"你知道了又能怎么样？现在的你什么都做不了。"},{"kindId":105,"page":90,"no":3,"classId":63,"side":1,"text":"佐助……你先别这么说……这也是我和鸣人想知道的。"},{"kindId":106,"page":90,"no":4,"classId":63,"side":1,"text":"小樱也是为了能够分析接下来的应对方案才会……"},{"kindId":107,"page":90,"no":5,"classId":54,"side":2,"text":"卡卡西……现在的你也和小樱一样，还是闭嘴一会吧……"},{"kindId":108,"page":90,"no":6,"classId":54,"side":2,"text":"我来一手搞定就行了！"},{"kindId":109,"page":90,"no":7,"classId":26,"side":1,"text":"混蛋佐助！不是说了要团队合作吗！"},{"kindId":110,"page":90,"no":8,"classId":63,"side":2,"text":"现在的我确实什么都做不到，如果你的左眼有分析外界现状的能力，那么佐助……"},{"kindId":111,"page":90,"no":9,"classId":63,"side":2,"text":"第七班四人小组的指挥权确实应该由你所掌握……"},{"kindId":112,"page":90,"no":10,"classId":26,"side":1,"text":"唉唉唉！？我可不认为这家伙能比卡卡西老师或是小樱想出更好的作战方案！虽然比我可能是强一些……"},{"kindId":113,"page":91,"no":1,"classId":36,"side":1,"text":"这……不会吧！！"},{"kindId":114,"page":91,"no":2,"classId":63,"side":2,"text":"下面是熔岩！？这是幻术吗！？不，这感觉……不对！"},{"kindId":115,"page":91,"no":3,"classId":63,"side":2,"text":"我猜这多半是敌人的能力，瞬间改变世界，而这世界又是真实存在的，就像中了幻术一样。"},{"kindId":116,"page":91,"no":4,"classId":26,"side":2,"text":"总之得先找到佐助！小樱！治疗就拜托你了！"},{"kindId":117,"page":92,"no":1,"classId":26,"side":2,"text":"可恶！我感到逐渐变得虚弱！得尽快找到佐助！"},{"kindId":118,"page":92,"no":2,"classId":36,"side":1,"text":"鸣人快过来我这边！"},{"kindId":119,"page":93,"no":1,"classId":26,"side":2,"text":"呼……还真起作用了。小樱你果然很可靠！"},{"kindId":120,"page":93,"no":2,"classId":36,"side":1,"text":"那是当然！在卡卡西老师的保护下，我会随时做好为你治疗的准备！"},{"kindId":121,"page":98,"no":1,"classId":46,"side":1,"text":"我先用鼻子来寻找气味，找到之后放出你的虫子……"},{"kindId":122,"page":98,"no":2,"classId":46,"side":1,"text":"这样配合很快就能找到蜂蜜酒，我真是太聪明了！就把这次行动当作我未来成为火影的热身好了！"},{"kindId":123,"page":98,"no":3,"classId":21,"side":2,"text":"……"},{"kindId":124,"page":98,"no":4,"classId":21,"side":2,"text":"牙？"},{"kindId":125,"page":98,"no":5,"classId":21,"side":2,"text":"喂！牙，你在哪？"},{"kindId":126,"page":98,"no":6,"classId":21,"side":2,"text":"虫子也迷失方向了吗？这毫无疑问是有人施的术。"},{"kindId":127,"page":103,"no":1,"classId":21,"side":2,"text":"怎么回事？周围的雾气中包含着迷惑方向的特殊成分，或许石块能派的上用场。"},{"kindId":128,"page":106,"no":1,"classId":21,"side":2,"text":"放不下过去，逃避未来的人，真的能算活在当下吗？"},{"kindId":129,"page":106,"no":2,"classId":21,"side":2,"text":"我知道那些为了遥远的目标，抓紧眼前一分一秒努力活着的人，他们才是活在当下的人。"},{"kindId":130,"page":107,"no":1,"classId":54,"side":1,"text":"这边。"},{"kindId":131,"page":107,"no":2,"classId":32,"side":2,"text":"哎，我说佐助，这又不是光顾常去的小店，多少也该警惕些吧。"},{"kindId":132,"page":107,"no":3,"classId":54,"side":1,"text":"机甲的位置调查清楚了，交涉就靠你了。"},{"kindId":133,"page":107,"no":4,"classId":32,"side":2,"text":"你说的那个抓走小樱，还要杀掉佐良娜的男人真的是大蛇丸手下吗？会不会有误会。"},{"kindId":134,"page":108,"no":1,"classId":54,"side":1,"text":"得想办法先灭火，或许前面的消防装置可以使用。"},{"kindId":135,"page":110,"no":1,"classId":1001,"side":2,"text":"你终于来了，可真够磨蹭的！"},{"kindId":136,"page":110,"no":2,"classId":32,"side":2,"text":"前面那是实验室的守卫吗？怎么都长一个样？糟糕，被发现了！"},{"kindId":137,"page":110,"no":3,"classId":1001,"side":2,"text":"没错，那是克隆人守卫，虽然没有我强大，但有无穷无尽的数量。"},{"kindId":138,"page":110,"no":4,"classId":1001,"side":2,"text":"去拖住他们，给我争取点时间，我有办法。"},{"kindId":139,"page":112,"no":1,"classId":54,"side":1,"text":"这里的守卫不断补充，暂时撤退换个方向调查。"},{"kindId":140,"page":113,"no":1,"classId":32,"side":2,"text":"果然这些守卫在不断补充，虽然不清楚那家伙有什么办法，但我相信它！"},{"kindId":141,"page":113,"no":2,"classId":1001,"side":2,"text":"破坏指定启动！"},{"kindId":142,"page":114,"no":1,"classId":1001,"side":2,"text":"终于等到你了，前面有一个隐藏的入口，或许对你有帮助。"},{"kindId":143,"page":115,"no":1,"classId":63,"side":1,"text":"真奇怪，我听说这小镇挺宁静的。"},{"kindId":144,"page":115,"no":2,"classId":24,"side":2,"text":"似乎在庆祝节日。"},{"kindId":145,"page":115,"no":3,"classId":63,"side":1,"text":"人们都戴着猫犬的面具，不知道是什么节日。"},{"kindId":146,"page":115,"no":4,"classId":24,"side":2,"text":"节日名称没写，一般都会写着才对啊。"},{"kindId":147,"page":115,"no":5,"classId":63,"side":1,"text":"我明白了！这个节日叫犬猫祭，或者猫犬祭。"},{"kindId":148,"page":115,"no":6,"classId":46,"side":2,"text":"为什么一个节日有两个名字？卡卡西老师……"},{"kindId":149,"page":115,"no":7,"classId":63,"side":1,"text":"我们先出发吧，晚些你就明白了。"},{"kindId":150,"page":116,"no":1,"classId":46,"side":2,"text":"等等，周围我闻着有些奇怪，好像嗅到一股气流从某处吹来。"},{"kindId":151,"page":116,"no":2,"classId":24,"side":2,"text":"或许是温泉的通风口吧，继续前进吧。"},{"kindId":152,"page":121,"no":1,"classId":63,"side":1,"text":"有了这个面具，就可以避免触犯到村民的风俗禁忌了。"},{"kindId":153,"page":121,"no":2,"classId":24,"side":2,"text":"这样我们应该就能通过那些禁止外来人士通过的区域了！"},{"kindId":154,"page":121,"no":3,"classId":46,"side":2,"text":"等等，让我猜猜，既然有犬面具，我们是不是也能搞到猫面具！"},{"kindId":155,"page":121,"no":4,"classId":63,"side":1,"text":"可以再找找看，面具应该不算宝物？暂时保管一下问题应该不大？"},{"kindId":156,"page":122,"no":1,"classId":46,"side":2,"text":"路上我一直在想那个奇怪的地方，现在天已经黑了，是不是可以去调查了……"},{"kindId":157,"page":122,"no":2,"classId":63,"side":1,"text":"时机也差不多了，一会绕过去猫派区域再看看好了……"},{"kindId":158,"page":124,"no":1,"classId":24,"side":2,"text":"真是幸运！又是一个面具！"},{"kindId":159,"page":124,"no":2,"classId":63,"side":1,"text":"这样猫派区域也能够畅通无阻了……"},{"kindId":160,"page":128,"no":1,"classId":32,"side":2,"text":"就是这儿吗？"},{"kindId":161,"page":128,"no":2,"classId":77,"side":1,"text":"根据情报显示的位置，这里就是草隐村掌管的鬼灯城监狱。"},{"kindId":162,"page":128,"no":3,"classId":32,"side":2,"text":"博人和巳月虽然是安全的，但我们不知道具体在哪片区域。"},{"kindId":163,"page":128,"no":4,"classId":77,"side":1,"text":"不用担心，在不暴露的情况下找到他们，静静观察就好。"},{"kindId":164,"page":128,"no":5,"classId":32,"side":2,"text":"你的意思是他们自己能处理好，不要影响他们的成长过程？"},{"kindId":165,"page":128,"no":6,"classId":77,"side":1,"text":"……"},{"kindId":166,"page":128,"no":7,"classId":77,"side":1,"text":"巳月的实力我清楚，他能保护其他人。"},{"kindId":167,"page":130,"no":1,"classId":52,"side":1,"text":"这是把从坠机地点带回的材料，解析完后得出的结果。"},{"kindId":168,"page":130,"no":2,"classId":52,"side":1,"text":"真不好意思，这件事也只能拜托会时空忍术的人去做了。"},{"kindId":169,"page":130,"no":3,"classId":54,"side":2,"text":"壳的大本营就在这个坐标吗？"},{"kindId":170,"page":130,"no":4,"classId":52,"side":1,"text":"很遗憾，并没有确凿的证据。"},{"kindId":171,"page":130,"no":5,"classId":54,"side":2,"text":"也可能是引诱我们出动的陷阱。"},{"kindId":172,"page":130,"no":6,"classId":52,"side":1,"text":"你也这么认为吗？"},{"kindId":173,"page":130,"no":7,"classId":54,"side":2,"text":"即便真的如此，现在的情况能前进一步是一步了。"},{"kindId":174,"page":131,"no":1,"classId":29,"side":2,"text":"祈求和平的人啊，我能看到你内心对于和平的渴望。"},{"kindId":175,"page":131,"no":2,"classId":29,"side":2,"text":"我可以帮助你建立一个没有战争的世界，并让你在那里继续生活下去。"},{"kindId":176,"page":131,"no":3,"classId":29,"side":2,"text":"你只需要返回过去，将这片土地上的人们说服并拯救下来，你就能建立一个没有战争的世界了。"},{"kindId":177,"page":132,"no":1,"classId":29,"side":2,"text":"这个传送门就是用于回溯时间、前往过去的装置，去吧，前往过去，改变历史的轨迹..."},{"kindId":178,"page":132,"no":2,"classId":29,"side":2,"text":"不用担心被困在过去，我在过去也放了一些传送门，也可以随时在过去与现在之间往返..."},{"kindId":179,"page":132,"no":3,"classId":29,"side":2,"text":"不过当你在过去做出一些抉择时，会导致因果变化，所以当你回到现在之后，你看到的景象可能会有些不同。"},{"kindId":180,"page":133,"no":1,"classId":29,"side":2,"text":"看来村庄附近埋伏了一群敌人，是否消灭这群碍事的家伙，你自己来决定吧。"},{"kindId":181,"page":133,"no":2,"classId":29,"side":2,"text":"我不会干涉你的行为，你只要记住你的每一个决定都会导致时间线走向不同的方向，进而影响到未来的走向。"},{"kindId":182,"page":134,"no":1,"classId":29,"side":1,"text":"愚蠢的人！你为什么使用这么极端的方法？我精心布局的计划，竟然因为你这样鲁莽的行为而落空了！"},{"kindId":183,"page":135,"no":1,"classId":32,"side":1,"text":"这个是第一次忍界大战时，留下的遗迹，不知道还有多少物品可以使用的..."},{"kindId":184,"page":135,"no":2,"classId":32,"side":1,"text":"前辈留下来的忍具可是好东西，可能还有一些不错的东西，得好好找找才行。"},{"kindId":185,"page":136,"no":1,"classId":32,"side":1,"text":"看来不少赏金猎人也来到这片土地了，连驻守在这边的联盟守军也无法全部阻挡住他们..."},{"kindId":186,"page":136,"no":2,"classId":32,"side":1,"text":"我记得千代婆婆和卡卡西老师被派遣到这边来协助，说不定可以找他们进行帮忙..."},{"kindId":187,"page":136,"no":3,"classId":32,"side":1,"text":"先去找他们两个吧，这样才能在这边快些找到遗留的宝物。"},{"kindId":188,"page":137,"no":1,"classId":36,"side":2,"text":"鸣人，这边敌人不少，做好随时战斗的准备，不要太过于大意了。"},{"kindId":189,"page":137,"no":2,"classId":32,"side":1,"text":"嗯...敌人确实不少，但这样才能和佐助那家伙比比谁更厉害！"},{"kindId":190,"page":137,"no":3,"classId":36,"side":2,"text":"你可别光顾着比赛了，我们是为了深处的宝物的，不然我们的任务就失败了！"},{"kindId":191,"page":138,"no":1,"classId":32,"side":1,"text":"这里布满了机关，你看出什么门道了吗？"},{"kindId":192,"page":138,"no":2,"classId":36,"side":2,"text":"这是简单的机关，标记着不同的颜色的机关控制着对应颜色的石头，只要好好研究一下，就能找到出路了。"},{"kindId":193,"page":138,"no":3,"classId":32,"side":1,"text":"也就是说操控这个带有红色的机关，右边红色的石头就会倒下，左边红色的石头就会立起来吗？看来他们挺厉害的嘛，居然想得出这样的机关！"},{"kindId":194,"page":139,"no":1,"classId":32,"side":1,"text":"不愧是佐助，看来佐助也变强了，我也不能输给他！"},{"kindId":195,"page":140,"no":1,"classId":15,"side":1,"text":"角都，你看对面是不是有宝藏，这次你可是要发财了！"},{"kindId":196,"page":140,"no":2,"classId":34,"side":2,"text":"别啰嗦了，快来帮忙！这些石头真是麻烦死了！"},{"kindId":197,"page":140,"no":3,"classId":34,"side":2,"text":"对面就是满是宝藏的小路，但我们却被拦在这边！"},{"kindId":198,"page":140,"no":4,"classId":34,"side":2,"text":"对了，情报上不是提到过，有个类似控制器的东西，我想这个应该能够帮助我们！"},{"kindId":199,"page":140,"no":5,"classId":15,"side":1,"text":"确实是有这个东西，看来我们能安全过去了！"},{"kindId":200,"page":141,"no":1,"classId":15,"side":1,"text":"角都，瞧瞧我发现了什么！"},{"kindId":201,"page":141,"no":2,"classId":34,"side":2,"text":"双向传送阵？"},{"kindId":202,"page":141,"no":3,"classId":34,"side":2,"text":"希望不要被绕的晕头转向的吧！"},{"kindId":203,"page":142,"no":1,"classId":73,"side":1,"text":"这次的任务和之前的都不太一样，需要做好苦战的准备了！"},{"kindId":204,"page":142,"no":2,"classId":10,"side":2,"text":"我们可是最优秀的班级，只要团结一起就能轻松获胜了。"},{"kindId":205,"page":142,"no":3,"classId":14,"side":1,"text":"是啊，更何况我们还有鹿丸你这个军师呢！这次一定能轻松化解的！"},{"kindId":206,"page":143,"no":1,"classId":10,"side":2,"text":"鹿丸，这个印记看起来有些奇怪，应该是有什么意义吧？"},{"kindId":207,"page":143,"no":2,"classId":73,"side":1,"text":"这些印记应该是连接索桥的，需要找到其他的印记，这样才能安全渡过！"},{"kindId":208,"page":143,"no":3,"classId":73,"side":1,"text":"印记应该不会相距很远，再这个附近找一找吧！"},{"kindId":209,"page":144,"no":1,"classId":14,"side":1,"text":"鹿丸，这个装置是什么机关？"},{"kindId":210,"page":144,"no":2,"classId":73,"side":1,"text":"这个应该是控制石头的机关，这样之前堵上的道路就能通过了。"},{"kindId":211,"page":145,"no":1,"classId":32,"side":2,"text":"这次任务看来十分容易，只需要剿灭附近的敌人就可以了。"},{"kindId":212,"page":145,"no":2,"classId":36,"side":1,"text":"鸣人，虽然只要剿灭敌人，但敌人数量过多，还是需要小心一点，以免中埋伏。"},{"kindId":213,"page":145,"no":3,"classId":63,"side":2,"text":"小樱说的没错，鸣人你执行任务的过程中还是需要在多考虑一些其他会影响到任务的因素。"},{"kindId":214,"page":145,"no":4,"classId":32,"side":2,"text":"但只要足够强大，这些都会引刃而解的，接下来就是检验修行成果的时候了！"},{"kindId":215,"page":146,"no":1,"classId":36,"side":1,"text":"前面好像是千代婆婆，过去看看吧！"},{"kindId":216,"page":146,"no":2,"classId":36,"side":1,"text":"说不定有能够帮助我们的信息。"},{"kindId":217,"page":147,"no":1,"classId":73,"side":1,"text":"这次多亏了佐助的帮助，才能打开这条小路，不然麻烦可就大了"},{"kindId":218,"page":147,"no":2,"classId":10,"side":2,"text":"是啊，要不是佐助帮忙，估计这条道路就没办法打开了"},{"kindId":219,"page":148,"no":1,"classId":73,"side":1,"text":"看来操作这个开关后，一些挡路的石头会发生变化"},{"kindId":220,"page":148,"no":2,"classId":73,"side":1,"text":"通过这个找到继续前进的道路"},{"kindId":221,"page":149,"no":1,"classId":32,"side":1,"text":"看来这次的任务和上次也差不多嘛..."},{"kindId":222,"page":149,"no":2,"classId":32,"side":1,"text":"这样的任务才能体现出忍者的价值和修行的成果嘛。"},{"kindId":223,"page":149,"no":3,"classId":63,"side":2,"text":"虽然是比较普通的剿灭任务，但雪之国这处藏宝地比较复杂，想要全部消灭还是有些困难."},{"kindId":224,"page":149,"no":4,"classId":32,"side":1,"text":"卡卡西老师，这方面就交给你了，我就负责击败敌人！"},{"kindId":225,"page":149,"no":5,"classId":63,"side":2,"text":"这处藏宝地应该不止这么小，先往前看看吧。"},{"kindId":226,"page":150,"no":1,"classId":63,"side":2,"text":"这边就进入叛军的地盘了，我们需要打起精神来，不能犯任何的失误。"},{"kindId":227,"page":150,"no":2,"classId":63,"side":2,"text":"在这里我们没有时间等到援军来支援，所以一切小心为上！"},{"kindId":228,"page":150,"no":3,"classId":32,"side":1,"text":"知道了，卡卡西老师。"},{"kindId":229,"page":150,"no":4,"classId":63,"side":2,"text":"四周的传送阵分别通往不同的地方，看来要完全剿灭的话，还需要去各个传送点看看了！"},{"kindId":230,"page":151,"no":1,"classId":32,"side":1,"text":"成功命中目标！起爆符还真是便利！"},{"kindId":231,"page":152,"no":1,"classId":73,"side":1,"text":"操作这个开关后，一些挡路的石头会发生变化"},{"kindId":232,"page":152,"no":2,"classId":73,"side":1,"text":"现在可以前往中间的地区了"},{"kindId":233,"page":153,"no":1,"classId":73,"side":1,"text":"佐助在一旁进行协助我们果然方便了很多"},{"kindId":234,"page":153,"no":2,"classId":73,"side":1,"text":"但佐助只会出手一次，所以需要看好起爆符的路径会不会被岩石给挡住"},{"kindId":235,"page":154,"no":1,"classId":63,"side":1,"text":"这块土地驻扎的敌人不少，要谨慎对待这些敌人。"},{"kindId":236,"page":154,"no":2,"classId":63,"side":1,"text":"并且这边的机关情况复杂，不可掉以轻心了！"},{"kindId":237,"page":155,"no":1,"classId":63,"side":1,"text":"和之前的石头类似，只需要找到对应颜色的开关就能打开这个通道了。"},{"kindId":238,"page":155,"no":2,"classId":63,"side":1,"text":"在这附近找看看吧，距离应该不会太远！"},{"kindId":239,"page":156,"no":1,"classId":32,"side":1,"text":"这次的任务有我们出马，那肯定能轻松解决的！"},{"kindId":240,"page":156,"no":2,"classId":36,"side":2,"text":"虽说有信心是好事，但情报上说这边的敌人有不少，看来又会是一场艰难的战斗了。"},{"kindId":241,"page":156,"no":3,"classId":36,"side":2,"text":"前进的道路被他们设置的障碍堵上了，看来还需要找佐助帮忙用起爆符炸开这些障碍了。"},{"kindId":242,"page":157,"no":1,"classId":11,"side":1,"text":"这次临时组织的忍者测试，看来最近村子要有大事发生了"},{"kindId":243,"page":157,"no":2,"classId":9,"side":2,"text":"不管是什么测试，我一定可以完成的！"},{"kindId":244,"page":157,"no":3,"classId":53,"side":2,"text":"这次测试和以往的不同，我先用白眼来看下周围的情况，之后我们在指定前进的路线。"},{"kindId":245,"page":158,"no":1,"classId":32,"side":2,"text":"这次对抗好像有不少强力的对手，虽说不是真的战争，但也需要全力以赴才行！"},{"kindId":246,"page":158,"no":2,"classId":32,"side":2,"text":"就让你们看看这次我修行后的结果吧，一定会让你们大吃一惊的。"},{"kindId":247,"page":158,"no":3,"classId":32,"side":2,"text":"先去找千代婆婆和卡卡西老师吧，想要胜利还需要他们的协助。"},{"kindId":248,"page":159,"no":1,"classId":32,"side":2,"text":"没想到这路口居然就有一个敌人，这次果然没有想象的这么简单"},{"kindId":249,"page":159,"no":2,"classId":32,"side":2,"text":"前方好像就是千代婆婆和卡卡西老师了，加速过去吧。"},{"kindId":250,"page":160,"no":1,"classId":40,"side":1,"text":"这忍村这么大，路上肯定还有不少的机关，这次任务看来不容易啊。"},{"kindId":251,"page":160,"no":2,"classId":72,"side":2,"text":"放心吧，我已经提前控制棋子把大部分的机关关闭了，只留下了一些比较明显的机关。"},{"kindId":252,"page":160,"no":3,"classId":72,"side":2,"text":"这样部分机关还在运转，砂之国就不会这么快发现我们的行动了。"},{"kindId":253,"page":161,"no":1,"classId":32,"side":1,"text":"我爱罗被晓组织给抓走了，现在正在进行尾兽抽离，需要尽快救出我爱罗。"},{"kindId":254,"page":161,"no":2,"classId":36,"side":2,"text":"情报上显示，我爱罗应该就在这片森林内，但晓组织应该会在这附近设下机关来阻碍我们"},{"kindId":255,"page":161,"no":3,"classId":36,"side":2,"text":"需要仔细在周围进行寻找机关"},{"kindId":256,"page":162,"no":1,"classId":32,"side":1,"text":"这边有一个卷轴碎片，看来应该是先头部队留下来的记录"},{"kindId":257,"page":162,"no":2,"classId":32,"side":1,"text":"上面说着西南方向有异常，看来需要先前往西南方向看看了"},{"kindId":258,"page":163,"no":1,"classId":36,"side":1,"text":"又是这种蛇形机关，看来这里应该是在晓组织附近了"},{"kindId":259,"page":163,"no":2,"classId":36,"side":1,"text":"尽快破解这些机关救出我爱罗吧"},{"kindId":260,"page":164,"no":1,"classId":32,"side":1,"text":"终于找到晓组织的秘密据点了！"},{"kindId":261,"page":164,"no":2,"classId":32,"side":1,"text":"这次说什么也要把这些人给消灭了，给我爱罗报仇！"},{"kindId":262,"page":164,"no":3,"classId":36,"side":2,"text":"鸣人先不要着急，这里毕竟是晓组织经营许久的地方，先观察一下周围，说不定有隐藏什么东西。"},{"kindId":263,"page":165,"no":1,"classId":32,"side":1,"text":"小樱，被你说中了，这边确实有隐藏的机关，"},{"kindId":264,"page":165,"no":2,"classId":32,"side":1,"text":"并且应该还有好几处这样的机关，这样才能连接桥面到对面去"},{"kindId":265,"page":166,"no":1,"classId":32,"side":1,"text":"终于没有任务需要出动了，但也不能懈怠下来.."},{"kindId":266,"page":166,"no":2,"classId":32,"side":1,"text":"那就来一点修行特训吧...在村子周围应该就可以了"},{"kindId":267,"page":167,"no":1,"classId":73,"side":1,"text":"真是麻烦，居然是这么艰难的任务..."},{"kindId":268,"page":167,"no":2,"classId":10,"side":2,"text":"鹿丸，你可要打起精神来啊，这次的任务地点听说有不少的机关和强劲的敌人.."},{"kindId":269,"page":167,"no":3,"classId":10,"side":2,"text":"还需要靠你的计谋破解呢！"},{"kindId":270,"page":168,"no":1,"classId":73,"side":1,"text":"看来这个无意触发的机关，连接着必经之路的桥面啊..."},{"kindId":271,"page":168,"no":2,"classId":73,"side":1,"text":"我们在四处找一找吧，这个机关应该不止一处..."},{"kindId":272,"page":169,"no":1,"classId":32,"side":1,"text":"虽然来到龟岛附近，但隔着大海无法过去，真是让人头疼,"},{"kindId":273,"page":169,"no":2,"classId":32,"side":1,"text":"他们好像说这边是有桥链接这龟岛的，只是被机关给隐藏起来了，"},{"kindId":274,"page":169,"no":3,"classId":32,"side":1,"text":"在这附近找看看吧，隐藏的机关应该就在这附近"},{"kindId":275,"page":170,"no":1,"classId":32,"side":1,"text":"通过了桥，但好像还没进入到龟岛内部..."},{"kindId":276,"page":170,"no":2,"classId":32,"side":1,"text":"旁边有传送阵，应该可以通往下一个地方，先去看看吧.."},{"kindId":277,"page":171,"no":1,"classId":32,"side":1,"text":"这个传送阵连接着各个岛屿.."},{"kindId":278,"page":171,"no":2,"classId":32,"side":1,"text":"但岛上的传送阵这么多，需要仔细记录位置，以免迷失方向.."},{"kindId":279,"page":172,"no":1,"classId":36,"side":1,"text":"佐助还是一如既往的可靠，这个苦无起爆符精准命中障碍物！"},{"kindId":280,"page":172,"no":2,"classId":32,"side":2,"text":"哼！这个佐助就会耍帅，接下来我得好好让小樱看看我的实力！"},{"kindId":281,"page":172,"no":3,"classId":36,"side":1,"text":"佐助投掷苦无的方向似乎被怪挡住了，鸣人，我们先把怪清理了再让佐助投掷起爆符吧！"},{"kindId":282,"page":173,"no":1,"classId":32,"side":2,"text":"这个印记好像激活了某处的机关.."},{"kindId":283,"page":173,"no":2,"classId":32,"side":2,"text":"在找看看这种印记，对我们应该很有帮助。"},{"kindId":284,"page":174,"no":1,"classId":36,"side":1,"text":"终于找完印记了，出现了一个传送门诶！"},{"kindId":285,"page":174,"no":2,"classId":32,"side":2,"text":"走吧，我们看看这个传送门通向哪里！"},{"kindId":286,"page":174,"no":3,"classId":36,"side":1,"text":"等等鸣人，这个传送门是个单向传送，进去后就无法出来了，还是需要小心一点！"},{"kindId":287,"page":175,"no":1,"classId":36,"side":2,"text":"终于到达龟岛内部了，这一路上可真不容易啊..."},{"kindId":288,"page":175,"no":2,"classId":32,"side":1,"text":"我已经准备准备好，迎接新的历练了..."},{"kindId":289,"page":175,"no":3,"classId":36,"side":2,"text":"也不知道佐助跑哪里去了..."},{"kindId":290,"page":176,"no":1,"classId":36,"side":2,"text":"鸣人，你快看，这边有个通道，不知道佐助会不会在这里面...."},{"kindId":291,"page":176,"no":2,"classId":32,"side":1,"text":"走，我们进去看看这个通道会通向哪里..."},{"kindId":292,"page":177,"no":1,"classId":32,"side":1,"text":"卡卡西老师，这里就是遗忘之森吗..."},{"kindId":293,"page":177,"no":2,"classId":32,"side":1,"text":"仿佛有几百双眼睛在看着我们"},{"kindId":294,"page":177,"no":3,"classId":63,"side":2,"text":"嗯，等一会跟紧我..."},{"kindId":295,"page":178,"no":1,"classId":32,"side":1,"text":"老师，前面有一条蛇..."},{"kindId":296,"page":178,"no":2,"classId":63,"side":2,"text":"这个蛇只是伪装，似乎是一种机关..."},{"kindId":297,"page":179,"no":1,"classId":32,"side":1,"text":"追了一路，也不知道卡卡西老师去哪里了..."},{"kindId":298,"page":179,"no":2,"classId":58,"side":2,"text":"前面的路被堵起来了，该怎么办啊..."},{"kindId":299,"page":179,"no":3,"classId":32,"side":1,"text":"我看到千代婆婆了，我们去问问千代婆婆有什么好办法..."},{"kindId":300,"page":180,"no":1,"classId":58,"side":2,"text":"千代婆婆，前面的路被堵起来了该怎么办呀..."},{"kindId":301,"page":180,"no":2,"classId":35,"side":1,"text":"别着急，卡卡西会把巨石移开的，你们小心点..."},{"kindId":302,"page":181,"no":1,"classId":58,"side":2,"text":"太好啦，有佐助的帮忙，我们肯定能更快追到叛徒..."},{"kindId":303,"page":181,"no":2,"classId":32,"side":1,"text":"有什么了不起的，不就是随便扔个东西嘛..."},{"kindId":304,"page":181,"no":3,"classId":58,"side":2,"text":"鸣人，别发呆了，我们快追..."},{"kindId":305,"page":182,"no":1,"classId":32,"side":1,"text":"这里怎么会这么荒芜，都已经好多天睡在大树上了...."},{"kindId":306,"page":182,"no":2,"classId":54,"side":2,"text":"前面好像有个村落，我们去问问有没有旅店吧..."},{"kindId":307,"page":182,"no":3,"classId":32,"side":1,"text":"要不还是算了，这个村落怎么总感觉怪怪的..."},{"kindId":308,"page":183,"no":1,"classId":54,"side":2,"text":"鸣人，你是不是又惹事了，这些村民为什么对我们穷追不舍..."},{"kindId":309,"page":183,"no":2,"classId":32,"side":1,"text":"我什么都没有做啊，刚进村落他们就对我们抱有敌意..."},{"kindId":310,"page":183,"no":3,"classId":54,"side":2,"text":"快跑，他们又追上来了..."},{"kindId":311,"page":184,"no":1,"classId":9,"side":1,"text":"这里就是师傅说的特训村了吗..."},{"kindId":312,"page":184,"no":2,"classId":9,"side":1,"text":"我要变的更强，才能更好的保护大家..."},{"kindId":313,"page":184,"no":3,"classId":9,"side":1,"text":"没有像他们一样的天赋，但我相信，我的体术也可以练到最强..."},{"kindId":314,"page":185,"no":1,"classId":9,"side":1,"text":"这是进入特训村的考验吗..."},{"kindId":315,"page":185,"no":2,"classId":9,"side":1,"text":"看来还要触发另外一处机关..."},{"kindId":316,"page":186,"no":1,"classId":9,"side":1,"text":"咦，前面发生了变化..."},{"kindId":317,"page":186,"no":2,"classId":9,"side":1,"text":"特训村我李洛克来了..."},{"kindId":318,"page":187,"no":1,"classId":36,"side":2,"text":"可算到地方了，这些盗贼不会跑了吧..."},{"kindId":319,"page":187,"no":2,"classId":32,"side":1,"text":"这次我要大展身手，让佐助好好的看看，我这段时间的苦修..."},{"kindId":320,"page":187,"no":3,"classId":54,"side":2,"text":"又是一场毫无意义的历练，真不知道鸣人这家伙又在想什么..."},{"kindId":321,"page":188,"no":1,"classId":36,"side":2,"text":"鸣人，你这份地图到底从哪里得到的..."},{"kindId":322,"page":188,"no":2,"classId":32,"side":1,"text":"不告诉你，反正跟着我走，把这些机关都触发了..."},{"kindId":323,"page":188,"no":3,"classId":54,"side":2,"text":"总感觉有人一直跟着我们..."},{"kindId":324,"page":189,"no":1,"classId":54,"side":2,"text":"这个地方总给我一种不好的预感...."},{"kindId":325,"page":189,"no":2,"classId":32,"side":1,"text":"别想这么多了，我们快跟着指示把机关都触发掉..."},{"kindId":326,"page":190,"no":1,"classId":36,"side":2,"text":"佐助，这个传送门会把我们传送到哪里去啊..."},{"kindId":327,"page":190,"no":2,"classId":32,"side":1,"text":"地图在我手上，不是应该问我的吗..."},{"kindId":328,"page":190,"no":3,"classId":54,"side":2,"text":"总之要小心为妙，这里没有看起来那么简单..."},{"kindId":329,"page":191,"no":1,"classId":33,"side":1,"text":"佐助，根据情报前面就是古国遗迹了..."},{"kindId":330,"page":191,"no":2,"classId":54,"side":2,"text":"已经破败成这样了，可以毁灭木叶的武器可能存在吗..."},{"kindId":331,"page":191,"no":3,"classId":33,"side":1,"text":"不管怎么说，我们先进去探查一下情况..."},{"kindId":332,"page":192,"no":1,"classId":33,"side":1,"text":"挡在前面的障碍物可能需要佐助你来处理了..."},{"kindId":333,"page":192,"no":2,"classId":54,"side":2,"text":"把敌人清理干净，剩下的交给我吧..."}]
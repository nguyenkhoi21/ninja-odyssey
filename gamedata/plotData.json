[{"kindId":1,"page":1,"no":1,"classId":54,"side":1,"text":"我绝对会阻止你们的！","soundId":null},{"kindId":2,"page":1,"no":2,"classId":54,"side":1,"text":"说到做到就是我的忍道。","soundId":null},{"kindId":3,"page":1,"no":3,"classId":11,"side":1,"text":"鸣人，小心点！他们想拖延我们完全复活十尾。","soundId":null},{"kindId":4,"page":1,"no":4,"classId":54,"side":1,"text":"爸爸，请帮我一把。","soundId":null},{"kindId":5,"page":1,"no":5,"classId":78,"side":1,"text":"来了，鸣人。我们一起并肩战斗。","soundId":null},{"kindId":6,"page":1,"no":6,"classId":54,"side":1,"text":"OK，让他们见识一下我们的厉害。","soundId":null},{"kindId":7,"page":1,"no":7,"classId":41,"side":1,"text":"你们别光顾着闲聊，十尾已经快成完全体了。","soundId":null},{"kindId":8,"page":1,"no":8,"classId":40,"side":1,"text":"斑那边由我来牵制，你们优先做好自己的事情。","soundId":null},{"kindId":9,"page":1,"no":9,"classId":54,"side":1,"text":"好的，一代大叔。看我的厉害。","soundId":null},{"kindId":10,"page":1,"no":10,"classId":11,"side":1,"text":"鸣人，我不会让你领先我的。","soundId":null},{"kindId":11,"page":1,"no":11,"classId":54,"side":1,"text":"佐助，你这强烈的胜负欲还是老样子。","soundId":null},{"kindId":12,"page":1,"no":12,"classId":11,"side":1,"text":"哼！你这吊车尾，还是这么嚣张。不要小瞧宇智波一族。","soundId":null},{"kindId":13,"page":1,"no":13,"classId":78,"side":1,"text":"鸣人，你有一个很棒的竞争对手呢。","soundId":null},{"kindId":14,"page":1,"no":14,"classId":41,"side":1,"text":"他两看着就像以前的大哥和斑。","soundId":null},{"kindId":15,"page":1,"no":15,"classId":38,"side":2,"text":"你们两也想起舞吗？！","soundId":null},{"kindId":16,"page":1,"no":16,"classId":40,"side":1,"text":"斑，有我在不会让你伤害他们的。","soundId":null},{"kindId":17,"page":1,"no":17,"classId":41,"side":1,"text":"大哥！啧，我们也跟上！","soundId":null},{"kindId":18,"page":1,"no":18,"classId":78,"side":1,"text":"就让我们这些死去的人再努力一下吧。","soundId":null},{"kindId":19,"page":1,"no":19,"classId":38,"side":2,"text":"哼，小蚊子般的烦人。须佐能乎！","soundId":null},{"kindId":20,"page":1,"no":20,"classId":37,"side":2,"text":"我会让你们进入没有伤害梦中的世界，放弃抵抗吧！","soundId":null},{"kindId":21,"page":1,"no":21,"classId":54,"side":1,"text":"那个世界是完全没有意义的虚假世界。","soundId":null},{"kindId":22,"page":1,"no":22,"classId":38,"side":2,"text":"十尾完全体复活了，没必要继续在这浪费时间了。","soundId":null},{"kindId":23,"page":1,"no":23,"classId":11,"side":1,"text":"必须阻止他们控制十尾。","soundId":null},{"kindId":24,"page":1,"no":24,"classId":54,"side":1,"text":"说得好，不愧是我的对手。","soundId":null},{"kindId":25,"page":1,"no":25,"classId":54,"side":1,"text":"要背负火影之名的男人是绝对不可能就这么认输的。","soundId":null}]